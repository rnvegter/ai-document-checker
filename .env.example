# Copy this file to .env and fill in the values.
#   cp .env.example .env
# Docker Compose and server.py both read .env. Never commit your real .env.

# --- Claude -------------------------------------------------------------
# Needed for "Deep check" and "Clean document". Without it only the instant check works.
ANTHROPIC_API_KEY=
# Claude model and effort (low | medium | high | xhigh | max). Higher effort is slower and costs more.
AI_CHECKER_MODEL=claude-opus-5-5
AI_CHECKER_EFFORT=medium

# --- Access -------------------------------------------------------------
# Password for the whole app (any username). Set this on every public deployment,
# or anyone who finds the URL can spend your Claude credit.
APP_PASSWORD=

# --- Clean document -----------------------------------------------------
# Author name written into cleaned .docx/.pptx files. Empty clears the author field.
CLEAN_AUTHOR=
# How many parts of a long document Claude rewrites at the same time.
CLEAN_CONCURRENCY=4

# --- Limits -------------------------------------------------------------
# Largest upload in megabytes, and the most characters of text per document.
MAX_UPLOAD_MB=20
MAX_DOCUMENT_CHARS=200000

# --- Network ------------------------------------------------------------
# Port on your machine that Docker Compose publishes the app on.
PUBLISH_PORT=8000
# Only used when running server.py directly (Docker always listens on 0.0.0.0:8000 inside the container).
HOST=127.0.0.1
PORT=8000
